<view class="page">
  <view class="heading">
    <view class="eyebrow">ESP32-S3 · 附近蓝牙控制</view>
    <view class="title">感应小哨兵</view>
    <view class="subtitle">本地感应与停鸣，手机调参和同步记录</view>
  </view>

  <view wx:if="{{error}}" class="error" role="alert">
    <text class="error-text" selectable>{{error}}</text>
    <button class="link-button error-dismiss" bindtap="dismissError">收起</button>
  </view>
  <view class="tabs">
    <button class="tab {{tab === 'device' ? 'selected' : ''}}" data-tab="device" bindtap="changeTab">设备</button>
    <button class="tab {{tab === 'settings' ? 'selected' : ''}}" data-tab="settings" bindtap="changeTab">参数<text wx:if="{{dirty}}"> ·</text></button>
    <button class="tab {{tab === 'logs' ? 'selected' : ''}}" data-tab="logs" bindtap="changeTab">记录</button>
  </view>

  <view wx:if="{{connected && storageWarning}}" class="notice">{{storageWarning}}</view>
  <view wx:if="{{connected && profileWarning}}" class="notice">{{profileWarning}}</view>
  <view wx:elif="{{connected && profileNotice}}" class="notice">{{profileNotice}}</view>

  <view wx:if="{{tab === 'device'}}">
    <view wx:if="{{!connected}}" class="panel">
      <view class="section-head"><view class="section-title">连接感应器</view><text class="badge">未连接</text></view>
      <view class="description">请在开发板附近打开微信。只显示本项目的 S3-Sentinel 设备。</view>
      <button wx:if="{{!scanning}}" class="button primary" loading="{{connecting}}" disabled="{{connecting}}" bindtap="scan">{{connecting ? '正在连接并读取参数' : '搜索附近设备'}}</button>
      <button wx:else class="button secondary" bindtap="stopScan">停止搜索</button>
      <view class="scan-hint">{{scanHint}}</view>
      <view wx:for="{{devices}}" wx:key="deviceId" class="device-row">
        <view class="device-info"><view class="device-name">{{item.name}}</view><view class="caption">信号 {{item.RSSI}} dBm</view></view>
        <button class="button small" data-index="{{index}}" bindtap="connect" disabled="{{connecting}}">连接</button>
      </view>
      <button class="link-button" bindtap="openPermissions">蓝牙权限设置</button>
    </view>

    <view wx:else>
      <view class="connected-line"><text>{{connectedName}}</text><button class="link-button" bindtap="disconnect">断开</button></view>
      <view class="status-panel {{sounding ? 'sounding' : ''}}">
        <text class="status-kicker">HC-SR505（三脚 PIR）</text>
        <view class="status-title">{{phaseLabel}}</view>
        <view class="status-detail">{{motionLabel}}</view>
        <view wx:if="{{phase === 'waiting_release'}}" class="caption">需先等待 OUT 恢复并稳定为低电平，再走动触发。</view>
        <view class="trigger-summary">本次启动活动 <text>{{triggerCount}}</text> 次</view>
      </view>
      <view class="panel toggles">
        <view class="toggle-row"><view><view>布防</view><view class="caption">关闭后继续记录活动，停止自动鸣叫</view></view><switch color="#087f51" checked="{{armed}}" disabled="{{actionBusy}}" bindchange="changeArmed" /></view>
        <view class="toggle-row"><view><view>静音</view><view class="caption">暂停自动发声，继续记录触发</view></view><switch color="#087f51" checked="{{muted}}" disabled="{{actionBusy}}" bindchange="changeMuted" /></view>
      </view>
      <button class="button stop" disabled="{{stopping}}" loading="{{stopping}}" bindtap="stop">立即停止输出</button>
      <view class="two-actions">
        <button class="button secondary" disabled="{{actionBusy}}" bindtap="test">试听设备声音</button>
        <button class="button secondary" disabled="{{actionBusy}}" bindtap="refresh">刷新状态</button>
      </view>
      <view class="notice">OUT 高表示检测信号处于保持状态，不能证明人此刻仍在动或静止在场。HC-SR505 的硬件灵敏度和输出保持时间不能通过小程序调整。</view>
      <view class="description bottom-note">已保存声音：{{savedSoundLabel}}。试听会绕过静音和布防，并单独记录。断开手机后，设备仍按已保存参数运行。</view>
    </view>
  </view>

  <view wx:if="{{tab === 'settings'}}">
    <view wx:if="{{!connected}}" class="notice">连接后读取设备实际参数。以下离线显示固件默认值，暂不可修改。</view>
    <view class="panel">
      <view class="section-title">HC-SR505 专用硬件</view>
      <view class="field"><text class="field-label">固定传感器</text><view>HC-SR505（三脚 PIR）</view><view class="caption">VCC → 5V · GND → GND · OUT → GPIO13</view></view>
      <view class="field"><text class="field-label">蜂鸣器</text><picker mode="selector" range="{{buzzerOptions}}" value="{{buzzerIndex}}" disabled="{{!connected || actionBusy}}" bindchange="buzzerChange"><view class="picker-value">{{buzzerOptions[buzzerIndex]}} <text>⌄</text></view></picker></view>
      <view class="caption">三脚不代表有源。请按模块资料选择 PWM 或开关模式，控制输入须兼容 3.3V。</view>
      <view class="toggle-row"><view><view>低电平驱动（空闲高电平）</view><view class="caption">有源、无源均按模块资料确认；无源需固件 1.0.3 起支持</view></view><switch color="#087f51" checked="{{draft.activeLow}}" disabled="{{!connected || actionBusy}}" bindchange="polarityChange" /></view>
      <view class="field"><text class="field-label">声音预设</text><picker mode="selector" range="{{soundOptions}}" value="{{soundIndex}}" disabled="{{!connected || actionBusy}}" bindchange="soundChange"><view class="picker-value">{{soundOptions[soundIndex]}} <text>⌄</text></view></picker></view>
      <view wx:if="{{draft.buzzerMode === 'active'}}" class="caption">有源模块只能改变开关节奏，无法变调；“警报”在有源模块上与单音相同。</view>
      <view wx:else class="caption">无源模块由设备生成预设音高与节奏；基础音高可在高级参数中设置。</view>
    </view>
    <view class="panel">
      <view class="section-head"><view class="section-title">鸣叫与再次触发</view><text class="caption">1000 毫秒 = 1 秒</text></view>
      <view class="number-row"><label for="beepMs">响铃时长<text class="caption">100–10000 毫秒</text></label><input id="beepMs" class="number-input" type="number" maxlength="7" value="{{draft.beepMs}}" disabled="{{!connected || actionBusy}}" data-field="beepMs" bindinput="draftNumber" /></view>
      <view class="number-row"><label for="cooldownMs">软件冷却<text class="caption">0–10000 毫秒</text></label><input id="cooldownMs" class="number-input" type="number" maxlength="7" value="{{draft.cooldownMs}}" disabled="{{!connected || actionBusy}}" data-field="cooldownMs" bindinput="draftNumber" /></view>
      <view class="caption">冷却结束且 OUT 连续为低电平后才会重新待命；信号持续为高不会自动再响。</view>
    </view>
    <button class="link-button advanced-toggle" bindtap="toggleAdvanced">{{advanced ? '收起高级参数' : '展开高级参数'}}</button>
    <view wx:if="{{advanced}}" class="panel">
      <view class="number-row"><label for="confirmMs">高电平确认时间<text class="caption">20–2000 毫秒</text></label><input id="confirmMs" class="number-input" type="number" maxlength="5" value="{{draft.confirmMs}}" disabled="{{!connected || actionBusy}}" data-field="confirmMs" bindinput="draftNumber" /></view>
      <view class="number-row"><label for="releaseMs">连续低电平时间<text class="caption">50–5000 毫秒</text></label><input id="releaseMs" class="number-input" type="number" maxlength="5" value="{{draft.releaseMs}}" disabled="{{!connected || actionBusy}}" data-field="releaseMs" bindinput="draftNumber" /></view>
      <view class="number-row"><label for="warmupMs">PIR 启动稳定时间<text class="caption">0–120000 毫秒</text></label><input id="warmupMs" class="number-input" type="number" maxlength="6" value="{{draft.warmupMs}}" disabled="{{!connected || actionBusy}}" data-field="warmupMs" bindinput="draftNumber" /></view>
      <view class="number-row"><label for="toneHz">无源蜂鸣器频率<text class="caption">200–5000 Hz</text></label><input id="toneHz" class="number-input" type="number" maxlength="4" value="{{draft.toneHz}}" disabled="{{!connected || actionBusy || draft.buzzerMode !== 'passive'}}" data-field="toneHz" bindinput="draftNumber" /></view>
      <view class="description">HC-SR505：VCC → 5V、GND → GND、OUT → GPIO13。蜂鸣器 S/IN → GPIO7，共地，蜂鸣器电源按其规格连接。</view>
      <view class="caption">确认、低电平释放和启动稳定时间都是程序等待时间，不会改变 HC-SR505 的硬件灵敏度或保持时间。</view>
      <view wx:if="{{connected}}" class="caption">{{diagnostics}} · 固件 {{version}}</view>
    </view>
    <button class="button primary" loading="{{actionBusy}}" disabled="{{!connected || actionBusy || (!dirty && !profileSaveFailed)}}" bindtap="save">{{profileSaveFailed ? '重新保存专用配置' : '保存到设备'}}</button>
    <button class="link-button" disabled="{{!connected || actionBusy || !dirty}}" bindtap="discardDraft">放弃未保存修改</button>
    <view class="description bottom-note">设备确认并持久保存后才显示成功。修改输出参数会停止当前鸣叫。</view>
  </view>

  <view wx:if="{{tab === 'logs'}}">
    <view class="panel">
      <view class="section-head"><view class="section-title">触发记录</view><text class="badge">缓存 {{cachedCount}} 条</text></view>
      <view wx:if="{{cacheDeviceLabel}}" class="caption cache-name">{{cacheDeviceLabel}}</view>
      <view class="description">北京时间；未校时记录保留启动编号与相对时间。活动触发是一轮检测输出片段，不等于人数；手动测试单独标记。</view>
      <view class="two-actions">
        <button wx:if="{{!syncing}}" class="button secondary" disabled="{{!connected}}" bindtap="syncLogs">增量同步</button>
        <button wx:else class="button secondary" bindtap="cancelSync">暂停同步</button>
        <button class="button secondary danger-text" disabled="{{!connected || syncing || actionBusy}}" bindtap="clearLogs">清除设备记录</button>
      </view>
      <view wx:if="{{syncHint}}" class="caption">{{syncHint}}</view>
      <view wx:if="{{gapWarning}}" class="notice compact">{{gapWarning}}</view>
      <view wx:if="{{cacheWarning}}" class="notice compact">{{cacheWarning}}</view>
      <view wx:if="{{!logs.length}}" class="empty">暂无缓存记录。连接后同步，或让设备检测一次活动。</view>
      <view wx:for="{{logs}}" wx:key="seq" class="log-row">
        <view class="log-heading"><view class="log-label">{{item.label}}<text wx:if="{{item.type === 'test'}}" class="test-tag">测试</text></view><text class="caption">#{{item.seq}}</text></view>
        <view class="log-time" selectable>{{item.timeLabel}}</view>
        <view class="log-result">{{item.resultLabel}}</view>
        <view class="caption">{{item.detail}}</view>
      </view>
      <button wx:if="{{canShowMore}}" class="link-button" bindtap="showMore">显示更早缓存记录</button>
      <view wx:if="{{logs.length}}" class="caption list-foot">最多展示最近 100 条；手机最多缓存 1000 条。</view>
    </view>
    <view class="description bottom-note">离线时可查看已有缓存。手机未连接时不接收实时蓝牙告警；设备继续检测并保存记录。</view>
  </view>
  <view class="footer">{{connected ? '已连接 · 参数以设备确认值为准' : '未连接 · 在设备附近搜索蓝牙'}}</view>
</view>
